---
import { getCollection } from 'astro:content';
import Layout from '../../components/Layout.astro'; import Header from '../../components/Header.astro'; import Footer from '../../components/Footer.astro'; import ProjectCard from '../../components/ProjectCard.astro'; import { copy, site } from '../../lib/site';
export async function getStaticPaths(){return [{params:{locale:'en'}},{params:{locale:'es'}}];}
const { locale } = Astro.params; const t = copy[locale]; const projects = (await getCollection('projects')).filter((p)=>p.data.locale===locale); const featured = projects.filter((p)=>p.data.featured);
---
<Layout locale={locale} title={`${site.name} — Product Designer`} description={t.heroText}><Header locale={locale}/><main id="main"><section class="hero shell"><p class="eyebrow">{t.eyebrow}</p><h1>{t.hero.split(' ').map((word, i) => i === t.hero.split(' ').length - 1 ? <em>{word}</em> : `${word} `)}</h1><p class="lede">{t.heroText}</p></section><section id="work" class="section shell"><div class="section-head"><h2>{t.selectedWork}</h2><a class="section-link" href={`/${locale}/projects/`}>{t.viewProject}</a></div><div class="project-grid">{featured.map((project)=><ProjectCard project={project} locale={locale}/>)}</div></section><section id="about" class="section about"><div class="shell"><p class="eyebrow">{t.eyebrow}</p><h2>{t.aboutTitle}</h2><p class="lede">{t.aboutText}</p><a class="button" href="/images/Resume-Juan-Sebastian-Lozano-Lamus.pdf" target="_blank">{t.cv}</a></div></section><section id="contact" class="contact"><div class="shell"><h2>{t.contactTitle}</h2><p>{t.contactText}</p><a class="button" href={`mailto:${site.email}?subject=Portfolio%20project`}>{t.emailMe} →</a></div></section></main><Footer/></Layout>
