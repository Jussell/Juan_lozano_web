---
import { getCollection, render } from 'astro:content'; import Layout from '../../../components/Layout.astro'; import Header from '../../../components/Header.astro'; import Footer from '../../../components/Footer.astro'; import { copy } from '../../../lib/site';
export async function getStaticPaths(){const all=await getCollection('projects'); return all.filter((p)=>!p.data.draft).map((project)=>({params:{locale:project.data.locale,slug:project.data.slug},props:{project}}));}
const {project}=Astro.props; const {Content}=await render(project); const {locale}=project.data; const t=copy[locale]; const all=(await getCollection('projects')).filter((p)=>p.data.locale===locale); const previous=all.find((p)=>p.data.slug===project.data.previousSlug); const next=all.find((p)=>p.data.slug===project.data.nextSlug);
const headings = [...(project.body ?? '').matchAll(/^(#{2,3})\s+(.+)\s*$/gm)].map(([, level, rawTitle]) => {
  const title = rawTitle.replace(/\s+#+\s*$/, '').replace(/\*\*(.*?)\*\*/g, '$1').replace(/\*(.*?)\*/g, '$1').replace(/`(.*?)`/g, '$1');
  const id = title.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  return { level: level.length, title, id };
});
---
<Layout locale={locale} title={project.data.title} description={project.data.summary}><Header locale={locale}/><main id="main"><div class="case-back shell"><a class="section-link" href={`/${locale}/projects/`}>← {t.back}</a></div><section class="case-hero shell"><h1>{project.data.title}</h1><p class="eyebrow">{project.data.tags.join(' · ')}</p><p class="lede">{project.data.summary}</p><dl class="case-meta"><div><dt>{t.role}</dt><dd>{project.data.role}</dd></div><div><dt>{t.duration}</dt><dd>{project.data.duration}</dd></div><div><dt>{t.tools}</dt><dd>{project.data.tools.join(', ')}</dd></div></dl><img class="case-cover" src={`/${project.data.cover}`} alt={project.data.title}/></section><section class="case-layout shell"><aside class="case-sidebar">{project.data.status==='in-progress'&&<div class="notice">{t.inProgress}</div>}{headings.length > 0 && <nav class="case-toc" aria-label={locale==='es'?'Secciones del caso':'Case study sections'}><p class="eyebrow">{locale==='es'?'En este caso':'In this case'}</p>{headings.map(({ level, title, id })=><a class={level===3?'case-toc-subsection':''} href={`#${id}`}>{title}</a>)}</nav>}</aside><article class="prose"><Content/></article></section><nav class="case-nav shell">{previous?<a href={`/${locale}/projects/${previous.data.slug}/`}>← {t.previous}</a>:<span/>}{next?<a href={`/${locale}/projects/${next.data.slug}/`}>{t.next} →</a>:<span/>}</nav></main><Footer/></Layout>
