---
// Root page that redirects to the default locale (/en/)
// We use a custom styled loader instead of return Astro.redirect() to avoid the unstyled redirect message.
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Juan Lozano — Product Designer</title>
  <meta http-equiv="refresh" content="0;url=/en/" />
  <style>
    :root {
      --ink: #171717;
      --paper: #f7f5f0;
      --accent: #e5b84b;
    }
    body {
      margin: 0;
      padding: 0;
      background: var(--paper);
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      font-family: system-ui, -apple-system, sans-serif;
    }
    .loader-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
    }
    .spinner {
      width: 40px;
      height: 40px;
      border: 3px solid rgba(23, 23, 23, 0.1);
      border-top: 3px solid var(--accent);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }
    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
    .redirect-link {
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      text-decoration: none;
      color: var(--ink);
      opacity: 0.6;
      font-weight: 700;
      transition: opacity 0.2s;
    }
    .redirect-link:hover {
      opacity: 1;
    }
  </style>
</head>
<body>
  <div class="loader-container">
    <div class="spinner"></div>
    <a href="/en/" class="redirect-link">Loading...</a>
  </div>
  <script is:inline>
    // Immediate fallback client-side redirect
    window.location.replace('/en/');
  </script>
</body>
</html>
